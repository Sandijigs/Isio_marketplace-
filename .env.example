# Isio environment
# Copy to .env.local. EVERYTHING IS OPTIONAL: with nothing set, Isio runs in
# demo mode (embedded database, simulated PayPal, simulated AI).
# Never commit .env.local.

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Database ──────────────────────────────────────────────────────────────────
# Empty → embedded PGlite Postgres stored in ./.data/isio (zero setup).
# Set → real Postgres (Supabase / Neon). Use the pooled connection string.
DATABASE_URL=""

# ── PayPal (developer.paypal.com → Apps & Credentials → Sandbox) ──────────────
# Empty → simulated payments. See docs/PAYPAL_SETUP.md.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# From the webhook you create in the PayPal dashboard (needed to verify webhooks).
PAYPAL_WEBHOOK_ID=""
# Optional override: "mock" or "paypal"
PAYMENTS_MODE=""
# Only for scripts/paypal-spike.ts: a sandbox business account that is not the app owner.
SPIKE_PAYEE_EMAIL=""

# ── AI (console.anthropic.com) ────────────────────────────────────────────────
# Empty → simulated AI drafts.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"
# Optional override: "mock" or "live"
AI_MODE=""

# ── Sessions ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=""

# ── Display ───────────────────────────────────────────────────────────────────
# USD→NGN rate for "≈ ₦" hints only. Never used for charging.
DEMO_USD_NGN_RATE="1500"
